# ============================================================================
# Docker Compose
# ============================================================================
COMPOSE_PROJECT_NAME=pgstack
TZ=America/Cuiaba

# ============================================================================
# PostgreSQL
# ============================================================================
# Image — pin semver major. A imagem pgvector é baseada no postgres oficial e
# é backward-compat 100% — se você não rodar `CREATE EXTENSION vector`, ela
# se comporta igual ao postgres padrão. Mas deixa a porta aberta pra embeddings
# sem downtime no futuro.
#
# Alternativas:
#   postgres:18-alpine              -> postgres puro (menor, sem pgvector)
#   pgvector/pgvector:pg18          -> postgres + pgvector (default aqui)
#   timescale/timescaledb:latest-pg17 -> time-series (ainda não tem pg18)
POSTGRES_IMAGE=pgvector/pgvector:pg18
POSTGRES_CONTAINER_NAME=postgres

POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_24
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Shared memory (tmpfs em /dev/shm). Precisa ser >= shared_buffers + overhead.
# Com shared_buffers=1536MB, 2gb dá folga confortável.
POSTGRES_SHM_SIZE=2gb

# Log driver (do container, não do Postgres)
POSTGRES_LOG_MAX_SIZE=10m
POSTGRES_LOG_MAX_FILE=3

# ============================================================================
# PostgreSQL tuning
# ----------------------------------------------------------------------------
# Valores calibrados pra container com ~6GB RAM dedicados, SSD, workload
# web/OLTP (read/write misto). Pra calibração mais fina baseada no seu CPU
# count e tipo de workload específico, rode https://pgtune.leopard.in.ua/
#
# Se quiser > 100 conexões simultâneas, melhor colocar PgBouncer na frente
# do que aumentar max_connections (cada conexão consome ~10MB + work_mem).
# ============================================================================
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=1536MB           # ~25% da RAM
PG_EFFECTIVE_CACHE_SIZE=4608MB     # ~75% da RAM (hint pro query planner)
PG_WORK_MEM=20MB                   # por operação de sort/hash, não por conn
PG_MAINTENANCE_WORK_MEM=512MB      # VACUUM, CREATE INDEX, ALTER TABLE
PG_LOG_MIN_DURATION=500            # loga queries lentas (ms). -1 desabilita.

# ============================================================================
# Backup scheduler
# ============================================================================
BACKUP_CONTAINER_NAME=postgres-backup
# Cron schedule (formato cron padrão de 5 campos)
# Exemplos:
#   "0 3 * * *"     -> todo dia às 03:00
#   "0 */6 * * *"   -> a cada 6h
#   "0 2 * * 0"     -> todo domingo às 02:00
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7
# Se true, roda um backup no momento em que o container sobe
BACKUP_ON_START=false

# ============================================================================
# PgBouncer (connection pooler — essencial pra Prisma, serverless, muitos workers)
# ----------------------------------------------------------------------------
# Com pooler na frente, apps conectam em pgbouncer:6432 em vez de postgres:5432.
# O pgbouncer mantém poucas conexões reais abertas ao postgres e multiplexa
# muitos clientes sobre elas. É o que permite suas 100 conexões postgres
# servirem 1000+ clientes.
# ============================================================================
PGBOUNCER_CONTAINER_NAME=pgbouncer
PGBOUNCER_PORT=6432

# transaction | session | statement
# - transaction: devolve conexão no fim de cada tx. Best default pra web apps.
# - session: devolve conexão no disconnect. Use se precisa de LISTEN/NOTIFY,
#   prepared statements (sem flag do Prisma), SET session, etc.
# - statement: devolve no fim de cada statement. Muito restritivo, raramente útil.
PGBOUNCER_POOL_MODE=transaction

# Quantos clientes podem conectar no pgbouncer simultaneamente
PGBOUNCER_MAX_CLIENT_CONN=1000

# Conexões reais ao postgres por (user, database). 
# REGRA: DEFAULT_POOL_SIZE × número de pools <= PG_MAX_CONNECTIONS
# Ex.: 25 × 4 pools = 100 conexões no postgres (= seu PG_MAX_CONNECTIONS).
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Pool de reserva pra picos (extras temporários)
PGBOUNCER_RESERVE_POOL_SIZE=5

# Quanto tempo o cliente espera por conexão livre antes de erro (segundos)
PGBOUNCER_QUERY_WAIT_TIMEOUT=120
